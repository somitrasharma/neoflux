// NeoFlux Pipeline Configuration
//
// Override any parameter via CLI: --param_name value
// Override any profile via: -profile docker,test

params {
    // -- Input/Output --
    samplesheet         = null
    outdir              = "results"
    publish_dir_mode    = "copy"

    // -- Reference genome (default: flash drive mount) --
    // To prepare: bash scripts/download_refdata.sh /Volumes/OMNYCS/neoflux_data
    // Then mount: docker run -v /Volumes/OMNYCS/neoflux_data:/opt/neoflux/data
    resources_base      = "/opt/neoflux/data"
    genome              = "GRCh38"
    genome_fasta        = "${params.resources_base}/genome/GRCh38.fa"
    genome_gtf          = "${params.resources_base}/genome/GRCh38.gtf"
    star_index          = "${params.resources_base}/indexes/star_index"
    salmon_index        = "${params.resources_base}/indexes/salmon_index"
    vep_cache_dir       = "${params.resources_base}/vep_cache"
    vep_version         = "111"

    // -- Tool toggles --
    run_ms              = false
    run_hla_typing      = true
    run_class_ii        = true
    skip_qc             = false

    // -- Variant calling --
    min_vaf             = 0.05
    min_depth           = 10
    callers             = "mutect2,strelka2"

    // -- Binding prediction --
    binding_tools       = "netmhcpan,mhcflurry,netmhcstabpan"
    peptide_lengths_i   = "8,9,10,11"
    peptide_lengths_ii  = "15"
    binding_threshold   = 500

    // -- ML model --
    model_path          = null
    train_model         = false

    // -- Fusion calling --
    star_fusion_lib     = null

    // -- Resource defaults --
    max_memory          = "64.GB"
    max_cpus            = 16
    max_time            = "48.h"

    // -- Stub/test --
    dry_run             = false
}

// -- Process defaults --
process {
    publishDir = [
        path:    { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode:    params.publish_dir_mode,
        saveAs:  { filename -> filename },
    ]

    errorStrategy = "retry"
    maxRetries    = 2

    cpus   = 2
    memory = "8.GB"
    time   = "4.h"

    // -- Per-process resource tuning --
    withName: "STAR_ALIGN"       { cpus = 8; memory = "48.GB"; time = "8.h" }
    withName: "BWA_MEM2"         { cpus = 8; memory = "32.GB"; time = "8.h" }
    withName: "MUTECT2"          { cpus = 4; memory = "16.GB"; time = "12.h" }
    withName: "STRELKA2"         { cpus = 4; memory = "16.GB"; time = "6.h" }
    withName: "STAR_FUSION"      { cpus = 8; memory = "32.GB"; time = "6.h" }
    withName: "NETMHCPAN"        { cpus = 4; memory = "8.GB"; time = "2.h" }
    withName: "MHCFLURRY"        { cpus = 4; memory = "8.GB"; time = "2.h" }
    withName: "SALMON_QUANT"     { cpus = 4; memory = "16.GB"; time = "2.h" }
    withName: "FRAGPIPE"         { cpus = 8; memory = "32.GB"; time = "12.h" }
    withName: "ML_SCORE"         { cpus = 4; memory = "16.GB"; time = "1.h" }

    // -- Container definitions --
    withName: "FASTQC"           { container = "biocontainers/fastqc:v0.12.1_cv2" }
    withName: "MULTIQC"          { container = "multiqc/multiqc:v1.25.1" }
    withName: "BWA_MEM2"         { container = "quay.io/biocontainers/bwa-mem2:2.2.1--hd03093a_5" }
    withName: "STAR_ALIGN|STAR_FUSION" { container = "trinityctat/starfusion:1.12.0" }
    withName: "DEDUP"            { container = "quay.io/biocontainers/sambamba:1.0.1--h6f6fda4_0" }
    withName: "OPTITYPE"         { container = "fred2/optitype:1.3.5" }
    withName: "HLA_HD"           { container = "quay.io/biocontainers/hlahd:1.7.0--hdfd78af_0" }
    withName: "LOHHLA"           { container = "mcgillcompbio/lohhla:latest" }
    withName: "MUTECT2"          { container = "broadinstitute/gatk:4.5.0.0" }
    withName: "STRELKA2"         { container = "quay.io/biocontainers/strelka:2.9.10--h9ee0642_1" }
    withName: "RMATS"            { container = "quay.io/biocontainers/rmats:4.3.0--py310h4b81fae_0" }
    withName: "VEP"              { container = "ensemblorg/ensembl-vep:release_112.0" }
    withName: "NETMHCPAN"        { container = "neoflux/netmhcpan:4.1" }
    withName: "MHCFLURRY"        { container = "quay.io/biocontainers/mhcflurry:2.1.0--pyhdfd78af_0" }
    withName: "NETMHCIIPAN"      { container = "neoflux/netmhciipan:4.3" }
    withName: "NETMHCSTABPAN"    { container = "neoflux/netmhcstabpan:1.0" }
    withName: "SALMON_QUANT"     { container = "combinelab/salmon:1.10.3" }
    withName: "FRAGPIPE"         { container = "fcyu/fragpipe:21.1" }
    withName: "PEPQUERY2"        { container = "quay.io/biocontainers/pepquery:2.0.2--hdfd78af_0" }
    withName: "PEPTIDE_GENERATION|FEATURE_ENGINEERING|ML_SCORE|PATIENT_REPORT|COHORT_REPORT|VAF_EXTRACT|PYCLONE|CONSENSUS_MERGE" {
        container = "neoflux/core:latest"
    }
}

// -- Execution profiles --
profiles {

    docker {
        docker.enabled = true
        docker.runOptions = "-u \$(id -u):\$(id -g)"
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    conda {
        conda.enabled = true
    }

    test {
        params {
            samplesheet    = "${projectDir}/assets/samplesheet.csv"
            outdir         = "test_results"
            resources_base = "${projectDir}/assets"
            genome_fasta   = "${projectDir}/assets/ref.fa"
            genome_gtf     = "${projectDir}/assets/ref.gtf"
            star_index     = "${projectDir}/assets/star_index"
            salmon_index   = "${projectDir}/assets/salmon_index"
            vep_cache_dir  = "${projectDir}/assets/vep_cache"
            max_cpus       = 2
            max_memory     = "4.GB"
            max_time       = "1.h"
        }
        process {
            cpus   = 1
            memory = "2.GB"
            time   = "30.m"
        }
    }

    stub {
        params.dry_run    = true
        params.model_path = ""
        process {
            cpus   = 2
            memory = "4.GB"
            time   = "30.m"
            withName: "STAR_ALIGN"       { cpus = 2; memory = "4.GB"; time = "30.m" }
            withName: "BWA_MEM2"         { cpus = 2; memory = "4.GB"; time = "30.m" }
            withName: "MUTECT2"          { cpus = 2; memory = "4.GB"; time = "30.m" }
            withName: "STRELKA2"         { cpus = 2; memory = "4.GB"; time = "30.m" }
            withName: "STAR_FUSION"      { cpus = 2; memory = "4.GB"; time = "30.m" }
            withName: "NETMHCPAN"        { cpus = 1; memory = "2.GB"; time = "30.m" }
            withName: "MHCFLURRY"        { cpus = 1; memory = "2.GB"; time = "30.m" }
            withName: "SALMON_QUANT"     { cpus = 2; memory = "4.GB"; time = "30.m" }
            withName: "FRAGPIPE"         { cpus = 2; memory = "4.GB"; time = "30.m" }
        }
    }

    lite {
        params {
            samplesheet    = "${projectDir}/assets/demo/samplesheet.csv"
            outdir         = "demo_results"
            model_path     = ""
            run_ms         = false
            skip_qc        = true
            binding_tools  = "mhcflurry"
            run_class_ii   = false
        }
        process {
            cpus   = 2
            memory = "4.GB"
            time   = "30.m"
            withName: "STAR_ALIGN"    { cpus = 2; memory = "4.GB"; time = "30.m" }
            withName: "BWA_MEM2"      { cpus = 2; memory = "4.GB"; time = "30.m" }
            withName: "MUTECT2"       { cpus = 2; memory = "4.GB"; time = "30.m" }
            withName: "STRELKA2"      { cpus = 2; memory = "4.GB"; time = "30.m" }
            withName: "STAR_FUSION"   { cpus = 2; memory = "4.GB"; time = "30.m" }
            withName: "SALMON_QUANT"  { cpus = 2; memory = "4.GB"; time = "30.m" }
        }
    }
}

// -- Manifest --
manifest {
    name            = "neoflux"
    author          = "Somitra Sharma"
    description     = "Unified neoantigen discovery and prioritization pipeline"
    mainScript      = "main.nf"
    nextflowVersion = ">=23.04.0"
    version         = "0.1.0"
}

// -- Reporting --
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report.html"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/dag.html"
}
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline.trace"
    overwrite = true
}
